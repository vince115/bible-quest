{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "dev-node22",
      "runtimeExecutable": "/bin/zsh",
      "runtimeArgs": [
        "-lc",
        "export PATH=\"$HOME/.nvm/versions/node/v22.22.0/bin:$PATH\" && exec pnpm dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "attach",
      "url": "http://localhost:3000"
    }
  ]
}
