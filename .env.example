# Serve card art, stage art and music from Cloudflare R2 (the bucket mirrors /public: cards/, stages/, audio/).
# Leave unset to use the files in /public.
# NEXT_PUBLIC_ASSET_BASE=https://pub-3de8339c6b3542e3a3312adc58bc9b63.r2.dev

# Testing: offer every card in free mode instead of only the ones in the player's collection.
# NEXT_PUBLIC_DEBUG_ALL_CARDS=1

# Draft card art from an image API (scripts/generate-art.art.ts; `pnpm art`). Keep real keys only in .env.local.
# ART_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1.5
# GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# ART_PROVIDER=leonardo
# LEONARDO_API_KEY=
# LEONARDO_MODEL_ID=

# Testing the gacha: packs cost nothing.
# NEXT_PUBLIC_DEBUG_FREE_PACKS=1
